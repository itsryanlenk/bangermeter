# Local working files (research materials, notes) — not part of the shipped tool
repo/
*.zip
.remember/
.claude/
ALGORITHM.md
HANDOFF.md
WEBSITE-BRIEF.md
WEBSITE-CHANGES-*.md
# Website agent working output: drafts, rendered page bodies, and ROLLBACK-*
# snapshots of the LIVE site. Working material, not part of the shipped tool —
# and the rollback files are copies of pages we did not author.
website-v*/

# Per-account archives pulled for analysis. These identify a specific person's
# posts and must never land in a public repo, so the pattern is blanket rather
# than per-file — a future `git add -A` cannot sweep one in by accident.
calibration/*.tsv
calibration/*-archive*.csv
# Samples collected by skills/audience-readout can land anywhere.
*-sample.tsv
*-archive*.tsv
audience-sample*.tsv

# Build artifacts
dist/

# OS noise
Thumbs.db
desktop.ini

# bangermeter-rank vendors the engine only inside a packed tarball
packages/bangermeter-rank/engine/
